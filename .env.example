# =======================================================
# NEURAX Environment Configuration Template
# Copy this file to .env for local development or copy
# values to the Render Dashboard "Environment Variables".
# =======================================================

# Secret key for signing JWT tokens (Render auto-generates this if using render.yaml)
JWT_SECRET_KEY=neurax-production-jwt-secret-replace-me

# Port (Render automatically sets $PORT, usually 10000)
PORT=5000

# -------------------------------------------------------
# Database Configuration (MySQL)
# -------------------------------------------------------
# OPTION A: Full connection string (e.g., from TiDB Cloud, Aiven, Railway)
# DATABASE_URL=mysql://username:password@gateway01.prod.aws.tidbcloud.com:4000/neurax_db

# OPTION B: Separate database credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neurax_db
# DB_SSL_DISABLED=false
# DB_SSL_CA=

# -------------------------------------------------------
# AI & Third-Party APIs
# -------------------------------------------------------
# Groq API key for patient chatbot and symptom classifier (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Places / Maps API Key (Optional: for hospital locator map)
GOOGLE_PLACES_KEY=

# -------------------------------------------------------
# Email (SMTP) Configuration (Optional: for OTP reset & notifications)
# -------------------------------------------------------
MAIL_EMAIL=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# -------------------------------------------------------
# Admin Account Defaults
# -------------------------------------------------------
ADMIN_EMAIL=admin@neurax.com
ADMIN_PASSWORD=admin123
